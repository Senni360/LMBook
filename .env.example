# Local only. Never put keys into VITE_ variables or commit .env.
PORT=4317
# Optional: Cartesia can also be connected from Settings in the app.
CARTESIA_API_KEY=
# Codex uses your locally installed CLI and its existing login.
# Optional override if the CLI was installed somewhere else:
CODEX_CLI_PATH=
# OpenCode Go reuses your CLI login, or accepts its own optional API key.
OPENCODE_API_KEY=
OPENCODE_CLI_PATH=
# Google Cloud Text-to-Speech: activate credits on this project's billing account.
# Use gcloud auth application-default login; no API key is required.
GOOGLE_CLOUD_PROJECT=
# Ollama is optional. Keep it local.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional MP3 export. Defaults to ffmpeg on PATH.
FFMPEG_PATH=
# Optional local transcription interpreter. Defaults to python on PATH.
SENNIBOOK_PYTHON=

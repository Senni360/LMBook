{
  "name": "sennibook",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server shared tests scripts electron/*.cjs *.json *.ts index.html",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --dir",
    "desktop:dist": "npm run build:desktop && electron-builder --win",
    "test:desktop": "npm run build:desktop && tsx --test tests/desktop.smoke.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "archiver": "8.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "google-auth-library": "11.0.2",
    "mammoth": "1.12.2",
    "multer": "2.3.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0",
    "yauzl": "3.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@fontsource/manrope": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.42.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "A local learning notebook for source-grounded educational audio.",
  "author": "SenniBook contributors",
  "main": "electron/main.cjs"
}
